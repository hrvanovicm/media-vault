# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Go source files MUST use tab indentation (gofmt standard)
[*.go]
indent_style = tab
indent_size = 4

# Makefiles MUST use tab indentation for recipes
[Makefile]
indent_style = tab

# YAML configuration files (golangci-lint, docker-compose, etc.)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Markdown documentation
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2